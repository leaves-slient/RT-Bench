# ============================================================================= 
# 使用说明：
# 1. 复制此文件为 models_config.yaml
# 2. 填写您的 API keys 和路径配置
# 3. models_config.yaml 已在 .gitignore 中，不会被提交到 Git
# =============================================================================

# 共享的API密钥配置
shared_keys:
  # Serper API密钥，用于搜索工具
  # Get your key from: https://serper.dev/
  SERPER_KEY_ID: "YOUR_SERPER_API_KEY_HERE"
  
  # Jina API密钥，用于访问工具
  # Get your key from: https://jina.ai/
  JINA_API_KEYS: "YOUR_JINA_API_KEY_HERE"
  
  # 阿里云 IDP（文档智能解析）密钥，用于文件解析工具
  # Get your key from: https://ram.console.aliyun.com/manage/ak
  # 可选：如果不配置，文件解析将使用本地解析库（pdfplumber, python-docx 等）
  IDP_KEY_ID: "YOUR_ALIYUN_ACCESS_KEY_ID_HERE"  # 请填写阿里云 AccessKey ID
  IDP_KEY_SECRET: "YOUR_ALIYUN_ACCESS_KEY_SECRET_HERE"  # 请填写阿里云 AccessKey Secret

# 数据集路径配置
datasets:
  L1: "/path/to/your/dataset/L1_questions.json"
  L2: "/path/to/your/dataset/l2_questions.json"
  L3: "/path/to/your/dataset/l3_questions.json"

# 输出基础路径
output_base: "/path/to/your/results"

# Python脚本路径
python_script: "/path/to/DeepResearch/inference/run_multi_react.py"

# 模型配置列表
models:
  # 模型1: GLM4.7
  GLM4.7:
    model_name: "glm47fp8"
    api_url: "http://your-api-url:port/v1"  # 请填写GLM4.7的API URL
    api_key: "YOUR_API_KEY_HERE"  # 请填写GLM4.7的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2 # 控制 rollouts 的并发数
    rollout_count: 1 # 每个题目运行多少次
    question_concurrency: 2  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型true false

  # 模型2: Qwen3-235B-A22B
  Qwen3-235B-A22B:
    model_name: "Qwen3-235B-A22B"
    api_url: "http://your-api-url:port/v1"  # 请填写Qwen3-235B-A22B的API URL
    api_key: "YOUR_API_KEY_HERE"  # 请填写Qwen3-235B-A22B的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 2  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

  # 模型3: Kimi-K2-thinking
  Kimi-K2-thinking:
    model_name: "Kimi-K2-thinking"
    api_url: "http://your-api-url:port/v1"  # 请填写Kimi-K2-thinking的API URL
    api_key: "YOUR_API_KEY_HERE"  # 请填写Kimi-K2-thinking的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 2 # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

  # 模型4: DeepSeek-V3.2
  DeepSeek-V3.2:
    model_name: "DeepSeek-V3.2"
    api_url: "http://your-api-url:port/v1"  # 请填写DeepSeek-V3.2的API URL
    api_key: "YOUR_API_KEY_HERE"  # 请填写DeepSeek-V3.2的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 4  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

  # 模型5: Doubao-Seed-1.8
  Doubao-Seed-1.8:
    model_name: "doubao-seed-1-8-251228"
    api_url: "https://ark.cn-beijing.volces.com/api/v3"  # 请填写Doubao-Seed-1.8的API URL
    api_key: "YOUR_DOUBAO_API_KEY_HERE"  # 请填写Doubao-Seed-1.8的API Key
    llm_provider: "doubao"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 3  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

  # 模型6: GPT5.2
  GPT5.2:
    model_name: "gpt-5_2"
    api_url: "https://api.openai.com/v1"  # 请填写GPT5.2的API URL
    api_key: "YOUR_OPENAI_API_KEY_HERE"  # 请填写GPT5.2的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 2  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

  # 模型7: gemini-3-pro-preview
  gemini-3-pro-preview:
    model_name: "gemini-3-pro-preview"
    api_url: "https://api.openai.com/v1"  # 请填写gemini-3-pro-preview的API URL
    api_key: "YOUR_API_KEY_HERE"  # 请填写gemini-3-pro-preview的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 4  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

  # 模型8: aws-claude-sonnet-4-5
  aws-claude-sonnet-4-5:
    model_name: "aws-claude-sonnet-4-5"
    api_url: "https://api.openai.com/v1"  # 请填写aws-claude-sonnet-4-5的API URL
    api_key: "YOUR_API_KEY_HERE"  # 请填写aws-claude-sonnet-4-5的API Key
    llm_provider: "openai"  # LLM提供方: "openai" 或 "doubao"
    use_function_calling: true  # 是否使用Function Calling方式调用工具（默认true，false则使用XML方式）
    temperature: 0.7
    presence_penalty: 1.1
    max_workers: 2
    rollout_count: 1
    question_concurrency: 3  # 每个模型并发处理题目的数量（默认3）
    enabled: true  # 是否启用此模型

# 运行设置
run_settings:
  # 要运行的模型列表（留空表示运行所有enabled=true的模型）
  # 可以使用模型名称，例如: ["GLM4.7", "Qwen3-235B-A22B", "GPT5.2"]
  # 如果为空列表 []，则运行所有 enabled: true 的模型
  # selected_models: ["GLM4.7", "Kimi-K2-thinking", "DeepSeek-V3.2", "GPT5.2", "Doubao-Seed-1.8","aws-claude-sonnet-4-5", "gemini-3-pro-preview"]
  selected_models: ["GPT5.2", "Doubao-Seed-1.8", "aws-claude-sonnet-4-5", "gemini-3-pro-preview"]
  # selected_models: ["Kimi-K2-thinking"]

  
  # 要运行的问题级别列表
  # 可选值: ["L1", "L2", "L3"] 或任意组合，例如: ["L1", "L2"]
  selected_levels: ["L1", "L2", "L3"]

  
  # 最大并行任务数（同时运行的模型+问题级别组合数）
  # 设置为0或负数表示串行执行（一个接一个运行）
  max_parallel_jobs: 2
  
  # 是否显示详细信息
  verbose: true

